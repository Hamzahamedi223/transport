# Root-level lockdown — only /public/ should ever be served.
Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|composer\.(json|lock)|.*\.sql|.*\.md)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.env.*|composer\.(json|lock)|.*\.sql|.*\.md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteCond %{REQUEST_URI} !^/(Transporteur/)?public/
RewriteCond %{REQUEST_URI} ^/(Transporteur/)?(app|config|database|routes|vendor|storage)/
RewriteRule ^ - [F,L]
